{
  "name": "@saganta/stellar-appkit-react-native",
  "version": "1.9.55",
  "description": "React Native connector + modal UI for Stellar AppKit — WalletConnect deep linking, Albedo WebView bridge, AsyncStorage persistence, full modal parity with the web SDK.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./polyfills": {
      "types": "./dist/polyfills.d.ts",
      "import": "./dist/polyfills.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    },
    "./albedo": {
      "types": "./dist/albedo/index.d.ts",
      "import": "./dist/albedo/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "dependencies": {
    "@saganta/stellar-appkit": "file:../stellar-appkit"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SagantaHQ/stellar-appkit"
  },
  "private": true
}
