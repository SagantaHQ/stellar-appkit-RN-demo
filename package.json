{
  "name": "stellar-appkit-rn-demo",
  "version": "1.0.0",
  "description": "Official React Native / Expo demo for @saganta/stellar-appkit-react-native — connect, sign, and transact on Stellar from Expo Go (no native build required).",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "bundle:check": "expo export --platform android --output-dir .bundle-check",
    "vendor:sync": "node scripts/sync-vendored-package.mjs"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@saganta/stellar-appkit": "file:packages/stellar-appkit",
    "@saganta/stellar-appkit-react-native": "file:packages/stellar-appkit-react-native",
    "@stellar/stellar-sdk": "^13.0.0",
    "@walletconnect/react-native-compat": "^2.23.10",
    "buffer": "^6.0.3",
    "expo": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
